#!/usr/bin/env python3
import sys


def banner(text, total_width=76, fill="-", prefix="# "):
    inner = total_width - len(prefix) * 2
    padded = f" {text} "
    dashes = padded.center(inner, fill)
    print(f"{prefix}{dashes}")


if __name__ == "__main__":
    text = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else "section"
    banner(text)
